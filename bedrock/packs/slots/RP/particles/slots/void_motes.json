{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "burmaldaholic:void_motes",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/burmaldaholic_slots"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(variable.count > 0 ? variable.count : 8, 60)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          0.2,
          0.5,
          0.05
        ],
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.6 + variable.particle_random_1 * 0.8"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.4,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.04 + variable.particle_random_2 * 0.03",
          "0.04 + variable.particle_random_2 * 0.03"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              8
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "frames_per_second": 3,
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#00B040FF",
            "0.2": "#FFD090FF",
            "1.0": "#006A2A9A"
          }
        }
      }
    }
  }
}
